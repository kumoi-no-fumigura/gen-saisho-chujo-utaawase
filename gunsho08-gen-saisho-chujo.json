 "poems": [
  {
   "seq": "1",
   "text": "色みえし心はかりはしつむれと泪はえこそ忍はさりけれ",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "いつしかとしほるゝ我か袂かな泪や戀のしるへ成らむ",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "風ふけはたちろく宿の板しとみやふれにけりな忍ふ心は",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "人しれぬ戀にはまけしと思ふにもうつ蟬のよそ悲しかりける",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "いはてたゝ思ひやりにてしらせはや人しれすのみこふる心を",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "なるかみの音に聞つる君なれは思ふこゝろをそらに知なむ",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "蘆のやのしのゝ小簾ひまをあらみもらしてしかなかくる心を",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "けふこそはいはせの森の下紅葉いろに出れはちりもしなゝめ",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "あひみても夜こそ戀は增りしかけふはひるをそくらし兼つる",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "うたゝねの夢かとのみそ歎かゝる明ぬるよほの程のなけれは",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "契りありて渡りそめなは泪川かへらぬ水の心ともかな",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "月草にすれる衣の朝露にかへるけささへ戀しきやなそ",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "いつのまにひなとしらみて白波のかへる空より戀しかるらむ",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "しら波にほかくる船もあるものをけさの沖をは何にたとへむ",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "くれまつと照日のかけを詠れはいるへき山のは社遠けれ",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "わかれぬるあしたのはらの忘水ゆくかたしらぬ我心かな",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "あふ事も我心よりありしかは戀はしぬとも人はうらみし",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "中〓〓に袖そ朽ぬる思ふともあはす泪のかゝらましやは",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "戀しさに絕ず流るゝ我袖のなみたを人のこゝろともかな",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "たはれにし妹にあふやと道のへにとひし夕そ人たのめなろ",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "こえなれし逢坂山のなそもかく戀路になりてまとふなるらん",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "くみみてし心ひとつをしるへにての中の〓水わすれやはする",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "つれなくは軈てつれなく成はてゝ又更〓〓につれなきやなそ",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "いつとたにまた逢事を契せは日をかそへても慰めてまし",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "思ひあまり詠るそらのかき曇り月さへ我をいとひつる哉",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "嵐吹よさむの里のねさめにはいとゝ人こそ戀しかりけれ",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "よと共に玉ちる床のすか枕みせはや人に夜はのけしきを",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "波のよる岩ねにたてるそなれ松またねもいらて戀あかしつる",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "戀わひてかたしく袖はかへせともいつかは妹か夢にみえける",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "我心ときそともなくみたるれと日たに暮れは戀そはりけり",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "我こひはかたうら染のから衣かへしてぬるや色にみゆらん",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "れぬまゝに月を詠てあかすかなやみには戀もなくさましかし",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "年をへて落る泪を衣手にたまゆらかけぬ時のまそなき",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "おもふ事いや年のはにつもる哉また打とくる人しなけれは",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "戀しさになるみの浦のはまひさきしほれてのみも年をふる哉",
   "kana": "",
   "speaker": "",
   "page": 478,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
